# Password-protects the whole app. See README.md "Set the password" section.
# Replace the AuthUserFile path below with the real absolute path your host
# gives you for .htpasswd (cPanel's "Directory Privacy" tool will fill this
# in for you automatically if you use that instead of creating it by hand).
AuthType Basic
AuthName "TornUp"
AuthUserFile "/REPLACE/WITH/ABSOLUTE/PATH/TO/.htpasswd"
Require valid-user

# Belt-and-suspenders: never serve .htpasswd (or any dotfile) as plain text,
# in case it ends up inside the web root and your host doesn't already block this.
<Files ".ht*">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
